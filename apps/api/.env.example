DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.example.com
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
ADMIN_KEY=replace-with-a-random-string-at-least-12-chars

# 放在 Nginx 后面时打开，否则限流拿不到真实客户端 IP
TRUST_PROXY=true

# 上传图片落盘目录，默认 apps/api/uploads
# UPLOAD_DIR=/var/www/wem/apps/api/uploads
