DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
PORT=4000

# 监听地址。默认 127.0.0.1：前端与 Nginx 都在本机，外部没有理由直连 4000。
# 绑 0.0.0.0 会让 http://<公网IP>:4000 绕过 HTTPS 与 Nginx 的所有响应头，
# 会话 Cookie 走明文。只有在容器/独立机器部署且前面没有本机反代时才改。
HOST=127.0.0.1

NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.example.com
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
ADMIN_KEY=replace-with-a-random-string-at-least-12-chars

# 接口文档默认在生产环境关闭（Swagger 会把整套路由与字段结构摊开）。
# 确实需要对外时显式打开，并确保 /api/docs 已在 Nginx 层拦住。
# ENABLE_API_DOCS=true

# 放在 Nginx 后面时打开，否则限流拿不到真实客户端 IP
TRUST_PROXY=true

# 上传图片落盘目录，默认 apps/api/uploads
# UPLOAD_DIR=/var/www/wem/apps/api/uploads
