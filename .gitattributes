# 统一换行符：Windows 上克隆后，Linux 侧的 shell/配置脚本仍是 LF
* text=auto

*.sh            text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
ecosystem.config.cjs text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.example       text eol=lf
Dockerfile      text eol=lf
